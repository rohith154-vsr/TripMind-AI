# ==============================================================================
# TripMind AI Frontend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set in Vercel Project Settings > Environment Variables
# ==============================================================================

# Backend API Base URL
# - Local development: Leave empty (Vite dev server proxies '/api' to localhost:8000)
# - Production deployment (Vercel): Set to your Render backend URL, for example:
#   VITE_API_BASE_URL=https://tripmind-ai-backend.onrender.com
VITE_API_BASE_URL=

