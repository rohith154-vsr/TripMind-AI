# ==============================================================================
# TripMind AI Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your environment:
#   Local development:  cp .env.example .env
#   Production (Render): Set these as Environment Variables in the Render Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider & Credentials
# ------------------------------------------------------------------------------
# Provider choice: "gemini" (recommended) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Only needed if AI_PROVIDER=openai: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Model identifiers
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Option A — Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./tripmind.db

# Option B — Production (Neon Serverless PostgreSQL - Direct or Pooled):
# The backend automatically normalizes postgresql://, maps sslmode=require to ssl=require,
# strips unsupported channel_binding=require, and configures PgBouncer statement caching.
# Direct:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Pooled (PgBouncer):
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ------------------------------------------------------------------------------
# 3. Application Settings & CORS Origins
# ------------------------------------------------------------------------------
# Environment mode: "development" or "production"
APP_ENV=development

# Allowed CORS origins (comma-separated, no trailing slashes)
# For local dev: http://localhost:5173,http://localhost:3000
# In production, specify your exact Vercel frontend domain to ensure origin isolation:
# CORS_ORIGINS=https://tripmind-ai.vercel.app
# For local dev:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Regex pattern for preview deployments (e.g. ephemeral PR previews).
# In production, prefer specifying exact origins in CORS_ORIGINS above.
# Broad regex patterns (e.g. https://.*\.vercel\.app) should NOT be used in production.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ------------------------------------------------------------------------------
# 4. Request Timeouts (in seconds)
# ------------------------------------------------------------------------------
LLM_TIMEOUT=90
HTTP_TIMEOUT=30
