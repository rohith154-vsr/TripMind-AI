# ==============================================================================
# TripMind AI Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your environment:
#   Local development:  cp .env.example .env
#   Production (Render): Set these as Environment Variables in the Render Dashboard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider & Credentials
# ------------------------------------------------------------------------------
# Provider choice: "gemini" (recommended) or "openai"
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Only needed if AI_PROVIDER=openai: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Model identifiers
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Option A — Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./tripmind.db

# Option B — Production (Neon Serverless PostgreSQL):
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
# The backend automatically normalizes postgresql:// and sslmode=require for asyncpg.
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Application Settings & CORS Origins
# ------------------------------------------------------------------------------
# Environment mode: "development" or "production"
APP_ENV=development

# Allowed CORS origins (comma-separated, no trailing slashes)
# For local dev: http://localhost:5173,http://localhost:3000
# For production: Add your Vercel frontend URL, e.g.
# CORS_ORIGINS=http://localhost:5173,https://tripmind-ai.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Regex pattern to allow Vercel preview deployment URLs
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ------------------------------------------------------------------------------
# 4. Request Timeouts (in seconds)
# ------------------------------------------------------------------------------
LLM_TIMEOUT=90
HTTP_TIMEOUT=30
